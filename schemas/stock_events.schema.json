{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type", "layer", "direction", "magnitude", "exposure",
          "horizon_days", "novelty", "source_quality",
          "evidence_confidence", "published_at", "source_type",
          "source_ids", "evidence_text", "actual", "expected"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "earnings", "earnings_guidance", "guidance", "order",
              "contract", "order_contract", "product", "technology",
              "product_technology", "management", "regulation",
              "litigation", "regulation_litigation", "merger", "buyback",
              "placement", "capital_action", "supply_chain",
              "supply_demand", "pricing_power", "inventory_cycle",
              "sector_policy", "competition", "policy_risk"
            ]
          },
          "layer": {"type": "string", "enum": ["company", "sector", "macro"]},
          "direction": {"type": "number", "minimum": -1, "maximum": 1},
          "magnitude": {"type": "number", "minimum": 0, "maximum": 1},
          "exposure": {"type": "number", "minimum": 0, "maximum": 1},
          "horizon_days": {"type": "integer", "minimum": 1, "maximum": 730},
          "novelty": {"type": "number", "minimum": 0, "maximum": 1},
          "source_quality": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "published_at": {"type": "string"},
          "source_type": {
            "type": "string",
            "enum": [
              "exchange_announcement", "official_policy", "company_ir",
              "research_report", "financial_news", "social_media"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"type": "string"}
          },
          "evidence_text": {
            "type": ["string", "null"],
            "maxLength": 120
          },
          "actual": {"type": ["number", "null"]},
          "expected": {"type": ["number", "null"]}
        }
      }
    }
  }
}
